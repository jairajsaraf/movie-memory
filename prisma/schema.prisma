generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js models, as the @auth/prisma-adapter docs give them (authjs.dev/getting-started/adapters/prisma).
model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  // One favorite movie per user; null means "not onboarded yet".
  favoriteMovie String?     @db.VarChar(200)
  accounts      Account[]
  sessions      Session[]
  facts         Fact[]
  leases        FactLease[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Facts are only ever inserted. `movie` is a snapshot of the title the fact was generated for, so
// "latest fact for this user + movie" is one index read and a movie change is a cache miss.
model Fact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  movie     String   @db.VarChar(200)
  text      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, movie, createdAt])
}

// Burst-protection gate. Never deleted: `blockedUntil` says when a new generation for this
// user + movie may next start; `token` is non-null only while a generation is in flight.
model FactLease {
  userId       String
  movie        String   @db.VarChar(200)
  token        String?  @db.Uuid
  blockedUntil DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, movie])
}
