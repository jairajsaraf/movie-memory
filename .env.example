# Copy to .env and fill in. .env is git-ignored; never commit it.

# Local Postgres from docker-compose.yml (these are throwaway local credentials).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory"
# The Vitest suite runs against this database and resets its tables.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory_test"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=""
# The app's origin. Required for `npm start` (production mode), where Auth.js otherwise rejects
# every request as an untrusted host. Change it if you run on another host or port.
AUTH_URL="http://localhost:3000"
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
